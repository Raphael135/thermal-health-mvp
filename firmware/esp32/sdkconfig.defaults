# O chip NÃO é fixado aqui: funciona no ESP32 e no ESP32-S3. Escolha com
# `idf.py set-target esp32` ou `idf.py set-target esp32s3` (apaga o sdkconfig e recria a partir
# deste arquivo).

# A biblioteca da Melexis guarda arrays de 3 KB na pilha ao ler a calibração do
# sensor (MLX90640_ExtractParameters), e o padrão do IDF é pequeno demais.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# BLE (NimBLE, o dispositivo é só periférico) + Wi-Fi + HTTPS client habilitados.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Guarda os pareamentos (chaves) na flash, para não parear de novo a cada reinício.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

CONFIG_ESP_WIFI_ENABLED=y

CONFIG_MBEDTLS_TLS_ENABLED=y
CONFIG_ESP_TLS_INSECURE=n
# Certificados raiz embutidos: a API (por exemplo atrás do Cloudflare) é verificada de verdade.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
