# Chip alvo: ESP32-S3. Vale para um projeto novo; num já configurado, rode
# `idf.py set-target esp32s3` (apaga o sdkconfig antigo e recria a partir deste arquivo).
CONFIG_IDF_TARGET="esp32s3"

# A biblioteca da Melexis guarda arrays de 3 KB na pilha ao ler a calibração do
# sensor (MLX90640_ExtractParameters), e o padrão do IDF é pequeno demais.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# BLE + Wi-Fi + HTTPS client habilitados.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

CONFIG_ESP_WIFI_ENABLED=y

CONFIG_MBEDTLS_TLS_ENABLED=y
CONFIG_ESP_TLS_INSECURE=n
