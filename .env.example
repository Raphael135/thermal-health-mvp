# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=thermal_health
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=thermal_health
POSTGRES_PORT=5432
DATABASE_URL=postgresql://thermal_health:change_me_local_only@postgres:5432/thermal_health?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── MinIO (S3-compatible storage) ────────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_local_only
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=thermal-exams
MINIO_USE_SSL=false

# ── API (NestJS) ──────────────────────────────────────────────────────────
API_PORT=3000
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
SIGNED_URL_EXPIRES_IN_SECONDS=300
CORS_ORIGIN=http://localhost:5173

# ── Thermal processor (FastAPI) ──────────────────────────────────────────
THERMAL_PROCESSOR_PORT=8000
THERMAL_PROCESSOR_URL=http://thermal-processor:8000

# ── Web panel (Vite) ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ── Mobile app (Expo) ─────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
