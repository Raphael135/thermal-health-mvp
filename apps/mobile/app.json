{
  "expo": {
    "name": "Thermal Health",
    "slug": "thermal-health-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF1EC",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "backgroundColor": "#C77D89",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#FBF1EC"
    },
    "android": {
      "package": "com.thermalhealth.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#C77D89"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
