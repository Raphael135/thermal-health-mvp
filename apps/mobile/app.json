{
  "expo": {
    "name": "Thermal Health",
    "slug": "thermal-health-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF1EC",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "backgroundColor": "#C77D89",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#FBF1EC"
    },
    "android": {
      "package": "com.thermalhealth.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#C77D89"
      }
    },
    "plugins": [
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "O app usa o Bluetooth para parear e controlar o aparelho térmico."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "39de711e-b60c-4d99-a15d-4a0f2f424ae3"
      }
    },
    "owner": "thermal-health"
  }
}
