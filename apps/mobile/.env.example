EXPO_PUBLIC_API_URL=http://localhost:3000
# Login automático sem senha ao abrir o app (só desenvolvimento local). Requer ALLOW_DEV_LOGIN=true na API.
EXPO_PUBLIC_ALLOW_DEV_LOGIN=false
EXPO_PUBLIC_DEV_LOGIN_EMAIL=paciente@teste.com
# Modo de teste: aviso de versão de teste, troca do endereço do servidor dentro do app e botão
# "Simular captura". Ligue só em builds para testadores (a API também precisa de ALLOW_DEMO_CAPTURE=true).
EXPO_PUBLIC_TEST_MODE=false
# Aparelho: "ble" = Bluetooth de verdade (padrão no celular); "simulated" = dados falsos, para builds
# de teste sem aparelho. Na web é sempre simulado.
EXPO_PUBLIC_DEVICE_MODE=ble
